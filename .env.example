# ============================================================
# Copia este archivo como .env y cambia los valores.
# NUNCA subas .env al repositorio ni compartas su contenido.
# ============================================================

# development | production
NODE_ENV=development

# Express. Para acceso directo por IP pública usa 0.0.0.0.
# Detrás de Nginx usa 127.0.0.1 para no exponer el puerto.
HOST=0.0.0.0
PORT=3000

# Si Express está detrás de Nginx, pon true para respetar X-Forwarded-*.
TRUST_PROXY=false

# Actívalo solo cuando HTTPS esté funcionando con un dominio real.
ENABLE_HSTS=false

# ------------------------------------------------------------
# Broker MQTT
# ------------------------------------------------------------
# mqtt:// para el puerto 1883 (sin cifrar) y mqtts:// para 8883 (TLS).
# No escribas usuario ni contraseña dentro de esta URL.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=dashboard
MQTT_PASSWORD=CAMBIA_ESTA_CLAVE_EN_EL_SERVIDOR

# Déjalo vacío para generar un ID único con el nombre del host y el PID.
MQTT_CLIENT_ID=

# Tópicos del proyecto
MQTT_TOPIC_POT=casa/potenciometro
MQTT_TOPIC_LED=casa/led

# Tópico donde el ESP32 confirma el estado real del LED.
# Déjalo vacío si tu firmware no publica confirmación.
MQTT_TOPIC_LED_STATE=casa/led/estado

# 0, 1 o 2. Se recomienda 1 para las lecturas y las órdenes.
MQTT_QOS=1

# La última orden ON/OFF queda retenida para que el ESP32 la reciba al reconectar.
MQTT_RETAIN_LED=true

# Reconexión del cliente MQTT
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000

# Para TLS con un certificado privado o una CA corporativa.
# Solo se usa con mqtts://. Debe ser la ruta a la CA pública, nunca una clave privada.
MQTT_CA_FILE=
MQTT_REJECT_UNAUTHORIZED=true

# Tiempo máximo de espera de la confirmación del ESP32.
MQTT_LED_ACK_TIMEOUT_MS=8000

# ------------------------------------------------------------
# Comportamiento del dashboard
# ------------------------------------------------------------
# Valor máximo esperado del ADC del ESP32 (12 bits = 4095).
POT_MAX=4095

# Tiempo sin lecturas tras el cual se muestra la alerta de datos obsoletos.
STALE_AFTER_MS=15000

# Muestras que se conservan para la gráfica.
HISTORY_SIZE=60

# Cada cuánto se registra una lectura en la lista de eventos (evita ruido).
READING_EVENT_INTERVAL_MS=30000
